# ── GazeAssist — Environment Variables ──────────────────────────────
# Copy this file to `.env` and fill in real values.
# Load with `python-dotenv` or set manually in your shell before running.


# ── Meta WhatsApp Cloud API (WhatsApp alerts) ────────────────────────
# Create a Meta Business app at https://developers.facebook.com,
# enable the WhatsApp product, and copy these from the API Setup page.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=


# ── Caregiver web dashboard (gazeassist_web) ─────────────────────────
# URL of the Django dashboard and this patient's API token. Get the token on
# the dashboard PC with:  python manage.py gaze_token <patient_id>
# Leave the token empty to run without the dashboard.
GAZEASSIST_API_URL=http://127.0.0.1:8000
GAZEASSIST_API_TOKEN=
