# ── GazeAssist — Environment Variables ──────────────────────────────
# Copy this file to `.env` and fill in real values.
# Load with `python-dotenv` or set manually in your shell before running.

# ── Fast2SMS (SMS alerts) ────────────────────────────────────────────
# Sign up at https://www.fast2sms.com and copy your API key.
FAST2SMS_API_KEY=

# ── Meta WhatsApp Cloud API (WhatsApp alerts) ────────────────────────
# Create a Meta Business app at https://developers.facebook.com,
# enable the WhatsApp product, and copy these from the API Setup page.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
