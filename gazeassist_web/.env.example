# Copy this file to .env and fill in the values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# e.g. http://192.168.1.20:8000 when opening the board from a phone on your Wi-Fi
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Kolkata
ONLINE_WINDOW_SECONDS=15
# How often dashboard pages poll for live updates (milliseconds)
POLL_INTERVAL_MS=3000
# Rate limit per gaze app token
GAZE_API_RATE=240/min

# Only when served over HTTPS:
SECURE_COOKIES=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
